# Required only for real Pi Agent inference. Without it, runs stop truthfully in "blocked".
DEEPSEEK_API_KEY=

# Optional. Defaults to deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional. Defaults to the repository's data/ directory.
FACTORY_DATA_DIR=

# Production only. Set all values as deployment-platform Secrets, never in Git.
ENV=
FACTORY_AUTH_REQUIRED=
AUTH_SECRET=
INVITE_CODES=
FACTORY_EMBED_WORKER=
FACTORY_PROJECT_ROOT=
FACTORY_MANUALS_DIR=
# Local HTTP acceptance only. Never set this to false when ENV=prod.
FACTORY_COOKIE_SECURE=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
BACKUP_INTERVAL_MS=
SENTRY_DSN=
