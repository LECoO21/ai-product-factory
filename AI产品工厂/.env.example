# Codex CLI executable. The default expects `codex` to be available on PATH.
CODEX_BINARY=codex

# Optional. Leave empty to use the model selected by the signed-in OpenAI account.
CODEX_MODEL=

# Optional. Maximum duration of one Codex Turn in milliseconds (default: 30 minutes).
CODEX_TURN_TIMEOUT_MS=1800000

# Optional. Defaults to the repository's data/ directory.
FACTORY_DATA_DIR=

# Production preparation only. The factory does not perform the actual deployment.
ENV=
FACTORY_EMBED_WORKER=
FACTORY_PROJECT_ROOT=
FACTORY_MANUALS_DIR=
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=
BACKUP_INTERVAL_MS=
SENTRY_DSN=
